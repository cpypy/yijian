{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yijian",
  "version": "0.1.5",
  "identifier": "app.yijian.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译见",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "resources": ["sidecar/**/*", "texbundle/**/*"]
  }
}
